# --- Database Configuration ---
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=kanban

# --- Security Configuration ---
# JWT Secret Key (Change this to a long random string in production)
SECRET_KEY=change-me-in-production

# --- Storage Configuration ---
# Choose storage backend: 'local' or 'r2'
STORAGE_BACKEND=local

# Cloudflare R2 Configuration (required only if STORAGE_BACKEND=r2)
# R2_ACCOUNT_ID=your-account-id
# R2_ACCESS_KEY_ID=your-access-key-id
# R2_SECRET_ACCESS_KEY=your-secret-access-key
# R2_BUCKET_NAME=your-bucket-name
# R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxx.r2.dev

# --- Network & Deployment Configuration ---
# Your host machine's Tailscale IPv4 address (run: tailscale ip -4)
HOST_TAILSCALE_IP=100.100.100.100

# The HTTP port exposed on the host machine. If port 80 is occupied, change this (e.g. 8080).
HOST_HTTP_PORT=80
